{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xender-secrets-v2",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-03",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/novel-data/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_STATE",
        "class_name": "AppState"
      },
      {
        "name": "COMMUNITY_INDEX",
        "class_name": "CommunityIndex"
      },
      {
        "name": "CONTENT_THREAD",
        "class_name": "ContentThread"
      }
    ]
  },
  "exports": {
    "AppState": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CommunityIndex": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ContentThread": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "APP_STATE",
          "class_name": "AppState"
        },
        {
          "name": "COMMUNITY_INDEX",
          "class_name": "CommunityIndex"
        },
        {
          "name": "CONTENT_THREAD",
          "class_name": "ContentThread"
        }
      ]
    }
  },
  "secrets": {
    "required": [
      "ADMIN_TOKEN"
    ]
  }
}
