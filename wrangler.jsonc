{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xender-secrets-v2",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-03",
  "vars": {
    "SITECHECK_PRO_OWNER_PILOT": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/novel-data/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_STATE",
        "class_name": "AppState"
      },
      {
        "name": "COMMUNITY_INDEX",
        "class_name": "CommunityIndex"
      },
      {
        "name": "CONTENT_THREAD",
        "class_name": "ContentThread"
      }
    ]
  },
  "exports": {
    "AppState": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CommunityIndex": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ContentThread": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "previews": {
    "vars": {
      "SITECHECK_PRO_OWNER_PILOT": "false"
    },
    "ai": {
      "binding": "AI"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "APP_STATE",
          "class_name": "AppState"
        },
        {
          "name": "COMMUNITY_INDEX",
          "class_name": "CommunityIndex"
        },
        {
          "name": "CONTENT_THREAD",
          "class_name": "ContentThread"
        }
      ]
    }
  },
  "secrets": {
    "required": [
      "ADMIN_TOKEN"
    ]
  },
  "routes": [
    {
      "pattern": "xendersecrets.com",
      "zone_name": "xendersecrets.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "www.xendersecrets.com",
      "zone_name": "xendersecrets.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "workers_dev": true,
  "preview_urls": true
}
