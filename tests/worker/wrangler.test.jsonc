// Local test config for tests/worker/canonical-worker.test.mjs: production wrangler.jsonc minus the
// remote-only AI binding, previews and secrets. The test fails if asset routing drifts from production.
{
  "name": "xender-secrets-v2-test",
  "main": "../../src/index.js",
  "compatibility_date": "2026-10-03",
  "vars": {
    "ADMIN_TOKEN": "local-payment-tests-only-32-chars",
    "RAZORPAY_KEY_ID": "local-test-key",
    "RAZORPAY_KEY_SECRET": "local-test-secret",
    "RAZORPAY_WEBHOOK_SECRET": "local-webhook-secret"
  },
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/novel-data/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_STATE",
        "class_name": "AppState"
      },
      {
        "name": "COMMUNITY_INDEX",
        "class_name": "CommunityIndex"
      },
      {
        "name": "CONTENT_THREAD",
        "class_name": "ContentThread"
      }
    ]
  },
  "exports": {
    "AppState": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CommunityIndex": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ContentThread": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
