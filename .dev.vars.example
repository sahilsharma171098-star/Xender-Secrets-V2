# Local-only Worker variables for `npm run dev` / `npm run dev:remote-ai`.
# Copy to .dev.vars (git-ignored) and fill in LOCAL TEST values only.
# Never paste production secrets here: production values live in the Cloudflare dashboard
# (Workers -> xender-secrets-v2 -> Settings -> Variables and Secrets).

# Admin MIS/leads routes (/api/admin/*). Any random local string of 24+ characters.
ADMIN_TOKEN=local-dev-admin-token-change-me-0123456789
# Salt for rate-limit hashing (src/growth.mjs). Any local string.
RATE_LIMIT_SALT=local-dev-salt

# Optional. Leave unset locally unless you are testing that integration with TEST credentials.
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TELEGRAM_CHANNEL_URL=
# Lead notifications: leave unset locally, or a lead submitted in dev pings the real chat.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
