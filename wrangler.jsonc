{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xender-secrets-v2",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
